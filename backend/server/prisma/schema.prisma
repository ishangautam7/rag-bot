generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ApplicationLog {
  id          Int      @id @default(autoincrement())
  session_id  String
  user_query  String
  ai_response String
  model       String
  created_at  DateTime @default(now())

  @@map("application_logs")
}

model User {
  id                String           @id @default(uuid())
  email             String           @unique
  username          String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  avatar            String?
  googleId          String?          @unique
  password          String?
  isAdmin           Boolean          @default(false)
  resetToken        String?
  resetTokenExpires DateTime?
  allowedModels     String[]         @default(["openrouter/auto"])
  activityLogs      ActivityLog[]
  folders           Folder[]
  sentMessages      Message[]
  promptTemplates   PromptTemplate[]
  sessions          Session[]
  memberships       SessionMember[]
  usageLogs         UsageLog[]
  refreshTokens     RefreshToken[]
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model Folder {
  id        String    @id @default(uuid())
  name      String
  color     String    @default("#6b7280")
  userId    String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions  Session[]

  @@index([userId])
}

model Session {
  id          String          @id @default(uuid())
  title       String?         @default("New Chat")
  status      ChatStatus      @default(ACTIVE)
  userId      String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  isGroupChat Boolean         @default(false)
  isPublic    Boolean         @default(false)
  shareToken  String?         @unique
  sharedAt    DateTime?
  folderId    String?
  isPinned    Boolean         @default(false)
  messages    Message[]
  folder      Folder?         @relation(fields: [folderId], references: [id])
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  members     SessionMember[]

  @@index([userId])
  @@index([shareToken])
  @@index([folderId])
}

model SessionMember {
  id        String     @id @default(uuid())
  sessionId String
  userId    String
  role      MemberRole @default(MEMBER)
  joinedAt  DateTime   @default(now())
  session   Session    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@index([sessionId])
  @@index([userId])
}

model Message {
  id         String    @id @default(uuid())
  content    String
  role       Role
  metadata   Json?
  sessionId  String
  createdAt  DateTime  @default(now())
  senderId   String?
  parentId   String?
  responseMs Int?
  sources    Json?
  parent     Message?  @relation("MessageThread", fields: [parentId], references: [id])
  replies    Message[] @relation("MessageThread")
  sender     User?     @relation(fields: [senderId], references: [id])
  session    Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([senderId])
  @@index([parentId])
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  details   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model PromptTemplate {
  id          String   @id @default(uuid())
  name        String
  prompt      String
  category    String   @default("general")
  description String?
  userId      String?
  createdAt   DateTime @default(now())
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([category])
}

model UsageLog {
  id               String   @id @default(uuid())
  userId           String
  date             String
  freeMessageCount Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
}

model Document {
  id        Int       @id @default(autoincrement())
  sessionId String?   @map("session_id") @db.VarChar
  filename  String?   @db.VarChar
  filePath  String?   @map("file_path") @db.VarChar
  createdAt DateTime? @map("created_at") @db.Timestamp(6)

  @@index([id], map: "ix_documents_id")
  @@index([sessionId], map: "ix_documents_session_id")
  @@map("documents")
}

enum Role {
  USER
  ASSISTANT
  SYSTEM
}

enum ChatStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

enum MemberRole {
  OWNER
  MEMBER
}
